    <!-- Custom Dashboard JavaScript -->
    <script src="/js/manhinhchinh-dashboard.js"></script>

    <script>
        // Pass data from ViewBag to JavaScript with null checks
        window.ageLabels = @Html.Raw(Json.Serialize(ViewBag.LineLabels ?? new string[0]));
        window.ageData = @Html.Raw(Json.Serialize(ViewBag.LineData ?? new int[0]));
        
        window.genderLabels = ["Nam", "Nữ", "Không xác định"];
        window.genderData = @Html.Raw(Json.Serialize(new int[] { (int)(ViewBag.MaleCount ?? 0), (int)(ViewBag.FemaleCount ?? 0), (int)(ViewBag.UnknownSexCount ?? 0) }));
        
        window.maritalLabels = @Html.Raw(Json.Serialize(ViewBag.MaritalStatusLabels ?? new string[0]));
        window.maritalData = @Html.Raw(Json.Serialize(ViewBag.MaritalStatusData ?? new int[0]));
        
        window.incomeLabels = @Html.Raw(Json.Serialize(ViewBag.PersonalIncomeLabels ?? new string[0]));
        window.incomeData = @Html.Raw(Json.Serialize(ViewBag.PersonalIncomeData ?? new int[0]));
        
        window.cityLabels = @Html.Raw(Json.Serialize(ViewBag.BarLabels ?? new string[0]));
        window.cityData = @Html.Raw(Json.Serialize(ViewBag.BarData ?? new int[0]));
        
        window.districtLabels = @Html.Raw(Json.Serialize(ViewBag.DistrictLabels ?? new string[0]));
        window.districtData = @Html.Raw(Json.Serialize(ViewBag.DistrictData ?? new int[0]));
        
        window.khuvucLabels = @Html.Raw(Json.Serialize(ViewBag.KhuvucLabels ?? new string[0]));
        window.khuvucData = @Html.Raw(Json.Serialize(ViewBag.KhuvucData ?? new int[0]));
        
        window.projectLabels = @Html.Raw(Json.Serialize(ViewBag.PieLabels ?? new string[0]));
        window.projectData = @Html.Raw(Json.Serialize(ViewBag.PieData ?? new int[0]));
        
        window.yearLabels = @Html.Raw(Json.Serialize(ViewBag.YearLabels ?? new string[0]));
        window.yearData = @Html.Raw(Json.Serialize(ViewBag.YearData ?? new int[0]));

        // Job and Industry distribution data
        window.jobLabels = @Html.Raw(Json.Serialize(ViewBag.JobLabels ?? new string[0]));
        window.jobData = @Html.Raw(Json.Serialize(ViewBag.JobData ?? new int[0]));
        
        window.industryLabels = @Html.Raw(Json.Serialize(ViewBag.IndustryLabels ?? new string[0]));
        window.industryData = @Html.Raw(Json.Serialize(ViewBag.IndustryData ?? new int[0]));

        // If no data from ViewBag, use test data
        if (!window.jobLabels || window.jobLabels.length === 0) {
            console.log('⚠️ No job data from ViewBag, using test data');
            window.jobLabels = ['Kinh doanh', 'Công nghệ', 'Giáo dục', 'Y tế', 'Dịch vụ'];
            window.jobData = [150, 120, 100, 80, 60];
        }
        
        if (!window.industryLabels || window.industryLabels.length === 0) {
            console.log('⚠️ No industry data from ViewBag, using test data');
            window.industryLabels = ['Thực phẩm', 'Thời trang', 'Điện tử', 'Xây dựng', 'Tài chính'];
            window.industryData = [200, 180, 160, 140, 120];
        }

        // Debug: Check if data is loaded
        console.log('🔍 DEBUG - Job Chart Data:');
        console.log('Job Labels:', window.jobLabels);
        console.log('Job Data:', window.jobData);
        console.log('Job Labels length:', window.jobLabels ? window.jobLabels.length : 'undefined');
        console.log('Job Data length:', window.jobData ? window.jobData.length : 'undefined');
        
        console.log('🔍 DEBUG - Industry Chart Data:');
        console.log('Industry Labels:', window.industryLabels);
        console.log('Industry Data:', window.industryData);
        console.log('Industry Labels length:', window.industryLabels ? window.industryLabels.length : 'undefined');
        console.log('Industry Data length:', window.industryData ? window.industryData.length : 'undefined');

        // Function to initialize charts after data is loaded
        function initializeChartsAfterData() {
            console.log('🔍 DEBUG - Initializing charts after data load...');
            
            // Use the test function to create charts
            testCreateCharts();
        }

        // Call initialization after a short delay to ensure data is loaded
        setTimeout(initializeChartsAfterData, 1000);

        // Simple test function to create charts manually
        function testCreateCharts() {
            console.log('🔍 Testing chart creation...');
            
            // Test job chart
            const jobCanvas = document.getElementById('jobChart');
            if (jobCanvas) {
                console.log('✅ Job canvas found, creating chart...');
                try {
                    new Chart(jobCanvas, {
                        type: 'bar',
                        data: {
                            labels: window.jobLabels || ['Kinh doanh', 'Công nghệ', 'Giáo dục', 'Y tế', 'Dịch vụ'],
                            datasets: [{
                                label: 'Số lượng',
                                data: window.jobData || [150, 120, 100, 80, 60],
                                backgroundColor: ['#ff9a9e', '#fecfef', '#fad0c4', '#ffd1ff', '#c4f4f8']
                            }]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: false
                                }
                            },
                            scales: {
                                x: {
                                    beginAtZero: true,
                                    grid: {
                                        color: 'rgba(0, 0, 0, 0.1)'
                                    }
                                },
                                y: {
                                    grid: {
                                        color: 'rgba(0, 0, 0, 0.1)'
                                    }
                                }
                            }
                        }
                    });
                    console.log('✅ Job chart created successfully');
                } catch (error) {
                    console.error('❌ Error creating job chart:', error);
                }
            } else {
                console.error('❌ Job canvas not found');
            }
            
            // Test industry chart
            const industryCanvas = document.getElementById('industryChart');
            if (industryCanvas) {
                console.log('✅ Industry canvas found, creating chart...');
                try {
                    new Chart(industryCanvas, {
                        type: 'bar',
                        data: {
                            labels: window.industryLabels || ['Thực phẩm', 'Thời trang', 'Điện tử', 'Xây dựng', 'Tài chính'],
                            datasets: [{
                                label: 'Số lượng',
                                data: window.industryData || [200, 180, 160, 140, 120],
                                backgroundColor: ['#a8edea', '#fed6e3', '#ffecd2', '#fcb69f', '#ff9a9e']
                            }]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: false
                                }
                            },
                            scales: {
                                x: {
                                    beginAtZero: true,
                                    grid: {
                                        color: 'rgba(0, 0, 0, 0.1)'
                                    }
                                },
                                y: {
                                    grid: {
                                        color: 'rgba(0, 0, 0, 0.1)'
                                    }
                                }
                            }
                        }
                    });
                    console.log('✅ Industry chart created successfully');
                } catch (error) {
                    console.error('❌ Error creating industry chart:', error);
                }
            } else {
                console.error('❌ Industry canvas not found');
            }
        }

        // Call test function after a delay
        setTimeout(testCreateCharts, 2000);

        // Region (Bắc/Trung/Nam) uses the same counts as in the summary card
        window.regionLabels = ["Bắc", "Trung", "Nam"];
        window.regionData = @Html.Raw(Json.Serialize(new int[] { (int)(ViewBag.MienBacCount ?? 0), (int)(ViewBag.MienTrungCount ?? 0), (int)(ViewBag.MienNamCount ?? 0) }));
        console.log('Region labels:', window.regionLabels, 'Region data:', window.regionData);
        if (document.getElementById('regionChart') && typeof initializeRegionChart === 'function') {
            initializeRegionChart();
        }

        // Show specific chart groups
        function showChartGroup(group) {
            // Remove active class from all buttons
            document.querySelectorAll('.chart-controls .btn').forEach(btn => btn.classList.remove('active'));
            
            // Add active class to clicked button
            event.target.classList.add('active');
            
            // Hide all chart groups
            document.querySelectorAll('.chart-group').forEach(chart => {
                chart.style.display = 'none';
            });
            
            // Show selected group or all
            if (group === 'all') {
                document.querySelectorAll('.chart-group').forEach(chart => {
                    chart.style.display = 'block';
                });
            } else {
                document.querySelectorAll(`.chart-group.${group}`).forEach(chart => {
                    chart.style.display = 'block';
                });
            }
        }

        // Toggle data table
        function toggleDataTable() {
            const container = document.getElementById('dataTableContainer');
            const text = document.getElementById('tableToggleText');
            
            if (container.style.display === 'none') {
                container.style.display = 'block';
                text.textContent = 'Ẩn dữ liệu';
                } else {
                container.style.display = 'none';
                text.textContent = 'Xem dữ liệu';
            }
        }

        // Reset filters
        function resetFilters() {
            window.location.href = '@Url.Action("Index", "Manhinhchinh")';
        }

        // Load all data
        function loadAllData() {
            // This function can be implemented to load all data via AJAX
            alert('Chức năng này sẽ được phát triển trong tương lai');
        }

        // Export to Excel function based on DN logic
        function exportToExcel(buttonElement) {
            console.log('📊 Exporting to Excel...');

            const form = document.querySelector('.filter-form');

            if (!form) {
                alert('❌ Không tìm thấy form filters. Vui lòng thử lại.');
                return;
            }

            const formData = new FormData(form);

            // Convert to URL parameters
            const params = new URLSearchParams();

            // Add all form data
            for (let [key, value] of formData.entries()) {
                params.append(key, value);
            }

            // Collect checkbox values (for multiple selections)
            const checkboxes = document.querySelectorAll('input[type="checkbox"]:checked');
            checkboxes.forEach(checkbox => {
                if (checkbox.name && checkbox.value) {
                    params.append(checkbox.name, checkbox.value);
                }
            });

            console.log('📊 Export parameters:', params.toString());

            // Create download link
            const exportUrl = '/Manhinhchinh/ExportToExcel?' + params.toString();

            // Show loading message
            const originalText = buttonElement.innerHTML;
            buttonElement.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Đang xuất...';
            buttonElement.disabled = true;

            // Use fetch to check for errors before downloading
            fetch(exportUrl)
                .then(response => {
                    // Check if response is JSON (server returns JSON for queued export)
                    const contentType = response.headers.get('content-type');
                    if (contentType && contentType.includes('application/json')) {
                        return response.json().then(result => {
                            if (result && result.success) {
                                // Show success message (queued export)
                                const alertDiv = document.createElement('div');
                                alertDiv.className = 'alert alert-success alert-dismissible fade show mt-3';
                                alertDiv.innerHTML = `
                                    <i class="fas fa-check-circle me-2"></i>
                                    <strong>Thành công!</strong> ${result.message || 'Yêu cầu export đã được gửi. Vui lòng kiểm tra email.'}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                `;
                                const tableContainer = document.querySelector('#dataTableContainer');
                                if (tableContainer) {
                                    tableContainer.parentNode.insertBefore(alertDiv, tableContainer);
                                    setTimeout(() => { if (alertDiv.parentNode) { alertDiv.remove(); } }, 5000);
                                }
                                // Stop further processing
                                return; 
                            }
                            // JSON but not success → throw error to be caught below
                            throw new Error((result && result.message) || 'Lỗi khi export dữ liệu');
                        });
                    }
                    
                    // Non-JSON and OK → directly download file
                    if (response.ok) {
                        const link = document.createElement('a');
                        link.href = exportUrl;
                        link.style.display = 'none';
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);

                        // Show success message
                        const alertDiv = document.createElement('div');
                        alertDiv.className = 'alert alert-success alert-dismissible fade show mt-3';
                        alertDiv.innerHTML = `
                            <i class="fas fa-check-circle me-2"></i>
                            <strong>Thành công!</strong> File Excel đang được tải về.
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        `;
                        const tableContainer = document.querySelector('#dataTableContainer');
                        if (tableContainer) {
                            tableContainer.parentNode.insertBefore(alertDiv, tableContainer);
                            setTimeout(() => { if (alertDiv.parentNode) { alertDiv.remove(); } }, 5000);
                        }
                        return;
                    }

                    // Other cases
                    throw new Error('Lỗi khi tải file Excel');
                })
                .catch(error => {
                    console.error('Export error:', error);
                    alert('❌ Lỗi khi export: ' + error.message);
                })
                .finally(() => {
                    // Restore button
                    buttonElement.innerHTML = originalText;
                    buttonElement.disabled = false;
                });
        }

        // Clear all filters
        function clearAllFilters() {
            const form = document.querySelector('.filter-form');
            if (form) {
                form.reset(); // Reset form fields
                // Optionally, you might want to clear checkboxes or other specific elements
                // For example, if you have a specific class for checkboxes
                document.querySelectorAll('.custom-multi-select .dropdown-options input[type="checkbox"]').forEach(checkbox => {
                    checkbox.checked = false;
                });
                // If you have a specific class for select boxes, you might need to re-render them
                // This is a simplified example, in a real app, you'd re-render the multi-selects
                // or handle specific field resets.
                console.log('All filters cleared.');
                submitFilters(); // Apply filters after clearing
            }
        }

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Page loaded, initializing...');
            if (typeof initializeCharts === 'function') {
                console.log('Initializing all charts from inline script');
                initializeCharts();
            }

            // Close any open dropdowns when clicking export
            const exportBtn = document.getElementById('exportBtn');
            if (exportBtn) {
                exportBtn.addEventListener('click', function() {
                    document.querySelectorAll('.dropdown-options').forEach(dd => dd.style.display = 'none');
                });
            }
        });

        // Toggle filter section (show/hide navigation filters)
        function toggleNavigationFilter() {
            const section = document.getElementById('navigationFilterSection');
            const chevron = document.getElementById('filterChevron');
            if (!section) return;
            const isHidden = section.style.display === 'none' || section.style.display === '';
            section.style.display = isHidden ? 'block' : 'none';
            if (chevron) {
                chevron.classList.toggle('rotated', isHidden);
            }
        }

        // Open/close a custom dropdown
        function toggleDropdown(selectBoxEl) {
            const container = selectBoxEl.closest('.custom-multi-select');
            if (!container) return;
            const dropdown = container.querySelector('.dropdown-options');
            if (!dropdown) return;

            // Close others
            document.querySelectorAll('.dropdown-options').forEach(d => {
                if (d !== dropdown) d.style.display = 'none';
            });

            dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
        }

        // Filter options inside a dropdown by text
        function filterOptions(inputEl) {
            const term = (inputEl.value || '').toLowerCase();
            const wrap = inputEl.closest('.dropdown-options');
            if (!wrap) return;
            wrap.querySelectorAll('label').forEach(lbl => {
                const txt = (lbl.innerText || '').toLowerCase();
                lbl.style.display = txt.includes(term) ? 'block' : 'none';
            });
        }

        // Submit current filters
        function submitFilters() {
            const form = document.querySelector('.filter-form');
            if (form) form.submit();
        }

        // Close dropdowns on outside click / ESC
        document.addEventListener('click', (e) => {
            const isSelectBox = e.target.closest && e.target.closest('.select-box');
            const isDropdown = e.target.closest && e.target.closest('.dropdown-options');
            if (!isSelectBox && !isDropdown) {
                document.querySelectorAll('.dropdown-options').forEach(d => d.style.display = 'none');
            }
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                document.querySelectorAll('.dropdown-options').forEach(d => d.style.display = 'none');
            }
        });
    </script>
    
    <!-- Load the main dashboard JavaScript file -->
    <script src="~/js/manhinhchinh-dashboard.js"></script>
